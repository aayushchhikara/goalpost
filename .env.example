# Copy to .env and fill in. The backend refuses to start if a required key is missing.

# REQUIRED: IANA timezone used to decide what "today" and "this week" mean, e.g. Asia/Kolkata.
# Seeds the settings table on first startup; after that the stored setting is used.
GOALPOST_TIMEZONE=UTC

# REQUIRED: Fernet key used to encrypt stored connector tokens.
# Generate one with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOALPOST_ENCRYPTION_KEY=

# Optional: SQLite file location (defaults to data/goalpost.db).
# GOALPOST_DATABASE_URL=sqlite:///data/goalpost.db

# Optional: origin of the local frontend, the only origin CORS allows.
# GOALPOST_FRONTEND_ORIGIN=http://localhost:3000

# Optional: GitHub personal access token for the GitHub connector.
GITHUB_TOKEN=

# Optional: Google OAuth client for the Google Calendar connector.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Gemini API key for AI-assisted suggestions.
GEMINI_API_KEY=
