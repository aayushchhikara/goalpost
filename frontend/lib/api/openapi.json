            "type": "array"
          }
        },
        "title": "PlanWeekRequest",
        "type": "object"
      },
      "Priority": {
        "enum": [
          "high",
          "medium",
          "low"
        ],
        "title": "Priority",
        "type": "string"
      },
      "Tally": {
        "properties": {
          "done": {
            "title": "Done",
            "type": "integer"
          },
          "late": {
            "title": "Late",
            "type": "integer"
          },
          "missed": {
            "title": "Missed",
            "type": "integer"
          },
          "pending": {
            "title": "Pending",
            "type": "integer"
          },
          "planned": {
            "title": "Planned",
            "type": "integer"
          },
          "rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "done / (planned - skipped); null when nothing counts",
            "title": "Rate"
          },
          "skipped": {
            "title": "Skipped",
            "type": "integer"
          }
        },
        "required": [
          "planned",
          "done",
          "late",
          "skipped",
          "missed",
          "pending",
          "rate"
        ],
        "title": "Tally",
        "type": "object"
      },
      "TaskCreate": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/TaskKind",
            "default": "one_off"
          },
          "notes": {
            "default": "",
            "title": "Notes",
            "type": "string"
          },
          "plan": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlanTarget"
              },
              {
                "type": "null"
              }
            ],
            "description": "Plan straight into a week; otherwise one-offs go to the backlog"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority",
            "default": "medium"
          },
          "recurrence_days": {
            "anyOf": [
              {
                "items": {
                  "maximum": 6.0,
                  "minimum": 0.0,
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Recurring only",
            "title": "Recurrence Days"
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "title": "TaskCreate",
        "type": "object"
      },
      "TaskDetailResponse": {
        "properties": {
          "current_occurrence": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OccurrenceRead"
              },
              {
                "type": "null"
              }
            ],
            "description": "This week's occurrence, if any"
          },
          "history": {
            "description": "Every occurrence, newest week first",
            "items": {
              "$ref": "#/components/schemas/OccurrenceRead"
            },
            "title": "History",
            "type": "array"
          },
          "task": {
            "$ref": "#/components/schemas/TaskRead"
          }
        },
        "required": [
          "task",
          "current_occurrence",
          "history"
        ],
        "title": "TaskDetailResponse",
        "type": "object"
      },
      "TaskKind": {
        "enum": [
          "one_off",
          "recurring"
        ],
        "title": "TaskKind",
        "type": "string"
      },
      "TaskRead": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "first_planned_week_start": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Planned Week Start"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "in_backlog": {
            "title": "In Backlog",
            "type": "boolean"
          },
          "kind": {
            "$ref": "#/components/schemas/TaskKind"
          },
          "notes": {
            "title": "Notes",
            "type": "string"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "recurrence_days": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recurrence Days"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "notes",
          "kind",
          "priority",
          "recurrence_days",
          "in_backlog",
          "status",
          "first_planned_week_start",
          "created_at"
        ],
        "title": "TaskRead",
        "type": "object"
      },
      "TaskStatus": {
        "enum": [
          "open",
          "done",
          "dropped"
        ],
        "title": "TaskStatus",
        "type": "string"
      },
      "TaskSummary": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/TaskKind"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "recurrence_days": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recurrence Days"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "priority",
          "recurrence_days"
        ],
        "title": "TaskSummary",
        "type": "object"
      },
      "TaskUpdate": {
        "description": "Fields left out stay as they are.",
        "properties": {
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "priority": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Priority"
              },
              {
                "type": "null"
              }
            ]
          },
          "recurrence_days": {
            "anyOf": [
              {
                "items": {
                  "maximum": 6.0,
                  "minimum": 0.0,
                  "type": "integer"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Recurring only; applies to remaining days",
            "title": "Recurrence Days"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "title": "TaskUpdate",
        "type": "object"
      },
      "TodayResponse": {
        "properties": {
          "adherence": {
            "items": {
              "$ref": "#/components/schemas/Adherence"
            },
            "title": "Adherence",
            "type": "array"
          },
          "any_day": {
            "description": "This week's any-day occurrences",
            "items": {
              "$ref": "#/components/schemas/OccurrenceRead"
            },
            "title": "Any Day",
            "type": "array"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "iso_week": {
            "title": "Iso Week",
            "type": "integer"
          },
          "items": {
            "description": "Occurrences dated today",
            "items": {
              "$ref": "#/components/schemas/OccurrenceRead"
            },
            "title": "Items",
            "type": "array"
          },
          "summary": {
            "$ref": "#/components/schemas/Tally"
          },
          "week_start": {
            "format": "date",
            "title": "Week Start",
            "type": "string"
          }
        },
        "required": [
          "date",
          "week_start",
          "iso_week",
          "items",
          "any_day",
          "adherence",
          "summary"
        ],
        "title": "TodayResponse",
        "type": "object"
      },
      "WeekDay": {
        "properties": {
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "occurrences": {
            "items": {
              "$ref": "#/components/schemas/OccurrenceRead"
            },
            "title": "Occurrences",
            "type": "array"
          }
        },
        "required": [
          "date",
          "occurrences"
        ],
        "title": "WeekDay",
        "type": "object"
      },
      "WeekResponse": {
        "properties": {
          "adherence": {
            "description": "Recurring tasks only",
            "items": {
              "$ref": "#/components/schemas/Adherence"
            },
            "title": "Adherence",
            "type": "array"
          },
          "any_day": {
            "items": {
              "$ref": "#/components/schemas/OccurrenceRead"
            },
            "title": "Any Day",
            "type": "array"
          },
          "days": {
            "items": {
              "$ref": "#/components/schemas/WeekDay"
            },
            "title": "Days",
            "type": "array"
          },
          "iso_week": {
            "title": "Iso Week",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/WeekStatus"
          },
          "summary": {
            "$ref": "#/components/schemas/Tally"
          },
          "week_end": {
            "format": "date",
            "title": "Week End",
            "type": "string"
          },
          "week_start": {
            "format": "date",
            "title": "Week Start",
            "type": "string"
          }
        },
        "required": [
          "week_start",
          "week_end",
          "iso_week",
          "status",
          "days",
          "any_day",
          "adherence",
          "summary"
        ],
        "title": "WeekResponse",
        "type": "object"
      },
      "WeekStatus": {
        "enum": [
          "planning",
          "active",
          "closed"
        ],
        "title": "WeekStatus",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Goalpost",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/backlog": {
      "get": {
        "description": "Open one-off tasks not planned into any open week.",
        "operationId": "getBacklog",
        "parameters": [
          {
            "in": "query",
            "name": "priority",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Priority"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Priority"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BacklogResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Get Backlog",
        "tags": [
          "weeks"
        ]
      }
    },
    "/api/v1/jobs/close": {
      "post": {
        "description": "Run the close job now. It also runs at midnight and on startup.",
        "operationId": "runCloseJob",
        "parameters": [
          {
            "description": "Run as if it were this day. Testing only: a future day closes weeks early.",
            "in": "query",
            "name": "as_of",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Run as if it were this day. Testing only: a future day closes weeks early.",
              "title": "As Of"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CloseResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Run Close Job",
        "tags": [
          "jobs"
        ]
      }
    },
    "/api/v1/occurrences/{occurrence_id}": {
      "patch": {
        "description": "Move to another remaining day of the same week, or to \"any day\".",
        "operationId": "moveOccurrence",
        "parameters": [
          {
            "in": "path",
            "name": "occurrence_id",
            "required": true,
            "schema": {
              "title": "Occurrence Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OccurrenceUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OccurrenceRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Move",
        "tags": [
          "occurrences"
        ]
      }
    },
    "/api/v1/occurrences/{occurrence_id}/complete": {
      "post": {
        "description": "Mark done by hand. A missed occurrence is marked late.",
        "operationId": "completeOccurrence",
        "parameters": [
          {
            "in": "path",
            "name": "occurrence_id",
