{
  "components": {
    "schemas": {
      "Adherence": {
        "properties": {
          "done": {
            "title": "Done",
            "type": "integer"
          },
          "late": {
            "title": "Late",
            "type": "integer"
          },
          "missed": {
            "title": "Missed",
            "type": "integer"
          },
          "pending": {
            "title": "Pending",
            "type": "integer"
          },
          "planned": {
            "title": "Planned",
            "type": "integer"
          },
          "rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "done / (planned - skipped); null when nothing counts",
            "title": "Rate"
          },
          "skipped": {
            "title": "Skipped",
            "type": "integer"
          },
          "task_id": {
            "title": "Task Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "planned",
          "done",
          "late",
          "skipped",
          "missed",
          "pending",
          "rate",
          "task_id",
          "title"
        ],
        "title": "Adherence",
        "type": "object"
      },
      "BacklogItem": {
        "properties": {
          "attempts": {
            "description": "Weeks the task was planned into",
            "title": "Attempts",
            "type": "integer"
          },
          "last_planned_week_start": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Planned Week Start"
          },
          "task": {
            "$ref": "#/components/schemas/TaskRead"
          }
        },
        "required": [
          "task",
          "last_planned_week_start",
          "attempts"
        ],
        "title": "BacklogItem",
        "type": "object"
      },
      "BacklogResponse": {
        "properties": {
          "items": {
