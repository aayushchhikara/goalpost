          },
          "task_id": {
            "title": "Task Id",
            "type": "string"
          }
        },
        "required": [
          "task_id"
        ],
        "title": "PlanItem",
        "type": "object"
      },
      "PlanTarget": {
        "properties": {
          "date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "A day in that week, or null for any day (one-off only)",
            "title": "Date"
          },
          "week_start": {
            "description": "Monday of the week to plan into",
            "format": "date",
            "title": "Week Start",
            "type": "string"
          }
        },
        "required": [
          "week_start"
        ],
        "title": "PlanTarget",
        "type": "object"
      },
