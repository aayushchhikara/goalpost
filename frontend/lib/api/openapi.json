          "missed",
          "skipped"
        ],
        "title": "OccurrenceStatus",
        "type": "string"
      },
      "OccurrenceUpdate": {
        "properties": {
          "date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "New day in the same week, or null for any day",
            "title": "Date"
          }
        },
        "required": [
          "date"
        ],
        "title": "OccurrenceUpdate",
        "type": "object"
      },
      "PlanItem": {
        "properties": {
          "date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
